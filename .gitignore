# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Jupyter Notebook checkpoints & MyST build outputs
.ipynb_checkpoints/
**/.ipynb_checkpoints/
**/_build/

# Testing & code quality
.pytest_cache/
**/.pytest_cache/
.coverage
htmlcov/

# Editor and workspace settings
.vscode/
.idea/
*.swp
*.swo

# Large datasets, data dumps and model binaries
*.csv
*.xlsx
*.parquet
*.npz
*.pdf
*.joblib
*.pkl
*.zip
*.tar.gz
*.ps1
*.log
*.tmp
data/

# Excepciones: las figuras y los resultados del paper sí se versionan (son pequeños y el paper los necesita)
!paper/figures/*.pdf
!paper/resultados/*.csv
!paper/resultados/*.json
